{%- liquid
  assign card_image = block.settings.image
  if card_image == blank and block.settings.product != blank
    assign card_image = block.settings.product.featured_image
  endif
  assign card_title = block.settings.product_title
  if card_title == blank and block.settings.product != blank
    assign card_title = block.settings.product.title
  endif
  assign initial = block.settings.name | slice: 0, 1 | upcase
  assign rating = block.settings.rating | default: 5
-%}
<article class="lbc-card size-{{ size | default: 'md' }}" {{ block.shopify_attributes }}>
  <div class="lbc-photo">
    {%- if block.settings.photo_asset != blank -%}
      <img
        class="lbc-img"
        src="{{ block.settings.photo_asset | asset_url }}"
        alt="{{ card_title | escape }}"
        loading="lazy"
        width="800"
        height="640"
      >
    {%- elsif card_image != blank -%}
      {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '340, 480, 720', sizes: '332px', alt: card_title, class: 'lbc-img' }}
    {%- endif -%}
    <button class="lbc-heart" type="button" data-lbc-heart aria-pressed="false" aria-label="Save review from {{ block.settings.name | escape }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.4l-1.1-1C6.1 14.2 3.5 11.8 3.5 8.8 3.5 6.5 5.3 4.7 7.6 4.7c1.3 0 2.6.6 3.4 1.7.8-1.1 2.1-1.7 3.4-1.7 2.3 0 4.1 1.8 4.1 4.1 0 3-2.6 5.4-7.4 9.6l-1.1 1z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
    </button>
  </div>
  <div class="lbc-body">
    <div class="lbc-person">
      <span class="lbc-avatar tone-{{ tone }}" aria-hidden="true">{{ initial }}</span>
      <div>
        <div class="lbc-name">
          {{ block.settings.name | escape }}
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.2l2.3 2.3L14 7.2" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="lbc-meta">Verified customer</div>
      </div>
    </div>
    <div class="lbc-stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg class="{% if i > rating %}is-off{% endif %}" viewBox="0 0 20 20"><path fill="currentColor" d="M10 1.7l2.16 4.64 5.09.62-3.76 3.48.97 5.06L10 13.15 5.54 15.5l.97-5.06L2.75 6.96l5.09-.62L10 1.7z"/></svg>
      {%- endfor -%}
    </div>
    <span class="lbc-sr">{{ rating }} out of 5 stars</span>
    {%- if block.settings.review != blank -%}
      <p class="lbc-quote"><span class="lbc-qmark" aria-hidden="true">“</span>{{ block.settings.review | escape }}</p>
    {%- endif -%}
    {%- if card_title != blank -%}
      {%- if block.settings.product != blank -%}
        <a class="lbc-product" href="{{ block.settings.product.url }}">
      {%- else -%}
        <span class="lbc-product">
      {%- endif -%}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5V19a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 11.5 12 4l9 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.5 20v-5.2h5V20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>{{ card_title | escape }}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- if block.settings.product != blank -%}
        </a>
      {%- else -%}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
