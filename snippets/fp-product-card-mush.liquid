<div class="fp-card {% unless product.available %}fp-sold-out{% endunless %}">
  <a href="{{ product.url }}" class="fp-image-wrap">
    {% if product.compare_at_price > product.price %}
      <span class="fp-sale-badge">Sale</span>
    {% endif %}

    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 700 | image_tag:
        loading: 'lazy',
        widths: '300,400,500,600,700',
        sizes: '(max-width: 749px) 50vw, 25vw',
        alt: product.featured_media.alt | escape
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
  </a>

  <div class="fp-info">
    <a href="{{ product.url }}" class="fp-title">{{ product.title }}</a>

    <div class="fp-price-wrap">
      {% if product.compare_at_price > product.price %}
        <span class="fp-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="fp-price">{{ product.price | money }}</span>
    </div>

    {% if product.available %}
      <button 
        type="button" 
        class="fp-btn fp-add-to-cart" 
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      >
        {{ section.settings.button_text }}
      </button>
    {% else %}
      <button type="button" class="fp-btn" disabled>
        {{ section.settings.soldout_text }}
      </button>
    {% endif %}
  </div>
</div>