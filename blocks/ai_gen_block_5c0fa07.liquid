{% doc %}
  @prompt
    Fast Delivery
    Home delivery in 2-3 days
    
    Cash on Delivery
    Pay in cash when your order arrives
    
    Customer Support
    Call us on +880 1791-859990
    
    add dynamic option there we can change anything. add icon of related 3 column, if need i can add new column, syle should be add also. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }
  .ai-benefits-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }
  .ai-benefits-{{ ai_gen_id }}__item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: {{ block.settings.item_padding }}px;
    background: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_radius }}px;
    text-align: {{ block.settings.alignment }};
  }
  .ai-benefits-{{ ai_gen_id }}__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }
  .ai-benefits-{{ ai_gen_id }}__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ai-benefits-{{ ai_gen_id }}__title { margin: 0 0 5px; color: {{ block.settings.text_color }}; font-size: {{ block.settings.title_size }}px; font-weight: 700; line-height: 1.25; }
  .ai-benefits-{{ ai_gen_id }}__text { margin: 0; color: {{ block.settings.text_color }}; font-size: {{ block.settings.body_size }}px; line-height: 1.45; }
  .ai-benefits-{{ ai_gen_id }}__content { min-width: 0; }
  .ai-benefits-{{ ai_gen_id }}__link { color: inherit; text-decoration: none; }
  .ai-benefits-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .ai-benefits-{{ ai_gen_id }} { width: 100%; }
    .ai-benefits-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr)); }
    .ai-benefits-{{ ai_gen_id }}__item { gap: 10px; }
  }
{% endstyle %}

<div class="ai-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-{{ ai_gen_id }}__grid">
    {% for i in (1..6) %}
      {% liquid
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        assign title_key = 'item_' | append: i | append: '_title'
        assign text_key = 'item_' | append: i | append: '_text'
        assign icon_key = 'item_' | append: i | append: '_icon'
        assign link_key = 'item_' | append: i | append: '_link'
        assign enabled = block.settings[enabled_key]
        assign item_title = block.settings[title_key]
        assign item_text = block.settings[text_key]
        assign item_icon = block.settings[icon_key]
        assign item_link = block.settings[link_key]
      %}
      {% if enabled and item_title != blank %}
        <div class="ai-benefits-{{ ai_gen_id }}__item">
          <span class="ai-benefits-{{ ai_gen_id }}__icon" aria-hidden="true">
            {% case item_icon %}
              {% when 'delivery' %}
                <svg viewBox="0 0 24 24"><path d="M3 6h11v12H3zM14 10h4l3 3v5h-7z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/><path d="M3 10h7M3 13h5"/></svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24"><path d="M3 11a9 9 0 1 1 2.6 6.4"/><path d="M3 4v7h7M12 7v5l3 2"/></svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="12" width="4" height="7" rx="2"/><rect x="17" y="12" width="4" height="7" rx="2"/><path d="M17 19a5 5 0 0 1-5 3h-2"/></svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/><path d="m9 12 2 2 4-4"/></svg>
              {% when 'payment' %}
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg>
            {% endcase %}
          </span>
          <div class="ai-benefits-{{ ai_gen_id }}__content">
            {% if item_link != blank %}<a class="ai-benefits-{{ ai_gen_id }}__link" href="{{ item_link }}">{% endif %}
            <h3 class="ai-benefits-{{ ai_gen_id }}__title">{{ item_title | escape }}</h3>
            {% if item_text != blank %}<p class="ai-benefits-{{ ai_gen_id }}__text">{{ item_text | escape | newline_to_br }}</p>{% endif %}
            {% if item_link != blank %}</a>{% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

