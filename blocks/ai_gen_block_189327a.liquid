{% doc %}
  @prompt
    Create a slideshow hero with an independently customizable content background panel behind the heading, description, and buttons, matching a rectangular content area on the left over a full-width slide image. The panel must not cover the whole slide. Add editable controls for enabling the panel, solid background color or gradient, background opacity from 0–100% without reducing text or button opacity, optional background blur, padding, width, corner radius, border color/width, and shadow. Provide separate mobile and desktop panel sizing, positioning and text alignment. Allow each slide's image, heading, description, button text and link to be changed, with editable text colors and sizes and button colors. Include slideshow autoplay on/off, interval, navigation arrows and dots controls. Keep the content legible and the layout responsive. Start with a dark panel at 40% opacity. This is a replacement for the existing Slideshow hero, preserving the same visual concept, not an extra hero intended to remain alongside it., add button option in this slider after text. Button shoul dbe editable. add all posible options for edit and style, font and everything, button is not working, every slider should be different option, need to add option that i can change every slide differently
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-slideshow-{{ ai_gen_id }}{display:block;width:100%}.ai-slideshow-{{ ai_gen_id }}__frame{position:relative;width:{{ block.settings.desktop_width_percent }}%;height:{{ block.settings.desktop_height }}px;overflow:hidden;background:#222}.ai-slideshow-{{ ai_gen_id }}__slide{position:absolute;inset:0;display:flex;align-items:center;padding:clamp(18px,5vw,70px);visibility:hidden;opacity:0}.ai-slideshow-{{ ai_gen_id }}__slide.is-active{visibility:visible;opacity:1}.ai-slideshow-{{ ai_gen_id }}__image,.ai-slideshow-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-slideshow-{{ ai_gen_id }}__placeholder{background:#333}.ai-slideshow-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-slideshow-{{ ai_gen_id }}__panel{position:relative;z-index:1;width:var(--pw);max-width:100%;padding:var(--pp);text-align:var(--ta);border-radius:var(--rad);border:var(--bw) solid var(--bc);box-shadow:0 8px 30px rgba(0,0,0,.25);color:var(--tc)}.ai-slideshow-{{ ai_gen_id }}__panel:before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:var(--bg);opacity:var(--op)}.ai-slideshow-{{ ai_gen_id }}__heading{margin:0 0 14px;color:var(--hc);font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:var(--hs);line-height:1.15}.ai-slideshow-{{ ai_gen_id }}__desc{margin:0 0 16px;color:var(--dc);font-family:{{ block.settings.body_font.family }},sans-serif;font-size:var(--ds);line-height:1.5}.ai-slideshow-{{ ai_gen_id }}__desc p{margin:0}.ai-slideshow-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--bh);padding:0 var(--bp);background:var(--bb);color:var(--bt);border:var(--bbw) solid var(--bbc);border-radius:var(--br);font-family:{{ block.settings.button_font.family }},sans-serif;font-size:var(--bs);text-decoration:none;cursor:pointer}.ai-slideshow-{{ ai_gen_id }}__button:hover{background:var(--bhv);color:var(--bht)}.ai-slideshow-{{ ai_gen_id }}__button:focus-visible,.ai-slideshow-{{ ai_gen_id }}__control:focus-visible{outline:3px solid #ffbf47;outline-offset:3px}.ai-slideshow-{{ ai_gen_id }}__controls{position:absolute;z-index:3;inset:auto 16px 16px;display:flex;justify-content:space-between;align-items:center}.ai-slideshow-{{ ai_gen_id }}__control{min-width:40px;min-height:40px;border:1px solid #fff;border-radius:50%;background:#222;color:#fff;cursor:pointer}.ai-slideshow-{{ ai_gen_id }}__dot{width:14px;min-width:14px;height:14px;min-height:14px;padding:0}.ai-slideshow-{{ ai_gen_id }}__dot[aria-current=true]{background:#fff;box-shadow:inset 0 0 0 3px #111}@media(max-width:749px){.ai-slideshow-{{ ai_gen_id }}__frame{width:100%;height:{{ block.settings.mobile_height }}px}.ai-slideshow-{{ ai_gen_id }}__slide{padding:16px;align-items:var(--mp)}.ai-slideshow-{{ ai_gen_id }}__panel{width:var(--mpw);padding:var(--mpp);text-align:var(--mta)}.ai-slideshow-{{ ai_gen_id }}__heading{font-size:var(--mhs)}.ai-slideshow-{{ ai_gen_id }}__desc{font-size:var(--mds)}.ai-slideshow-{{ ai_gen_id }}__button{font-size:var(--mbs)}}
{% endstyle %}
<ai-slideshow-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" data-auto="{{ block.settings.autoplay }}" data-interval="{{ block.settings.interval | times: 1000 }}" {{ block.shopify_attributes }}><div class="ai-slideshow-{{ ai_gen_id }}__frame" aria-roledescription="carousel">
{% for i in (1..3) %}{% liquid
assign image_key = 'slide_' | append: i | append: '_image'
assign heading_key = 'slide_' | append: i | append: '_heading'
assign desc_key = 'slide_' | append: i | append: '_description'
assign text_key = 'slide_' | append: i | append: '_button_text'
assign link_key = 'slide_' | append: i | append: '_button_link'
assign panel_key = 'slide_' | append: i | append: '_panel_color'
assign opacity_key = 'slide_' | append: i | append: '_panel_opacity'
assign heading_color_key = 'slide_' | append: i | append: '_heading_color'
assign button_color_key = 'slide_' | append: i | append: '_button_color'
assign image = block.settings[image_key]
assign heading = block.settings[heading_key]
assign desc = block.settings[desc_key]
assign button_text = block.settings[text_key]
assign button_link = block.settings[link_key]
assign panel_color = block.settings[panel_key]
assign panel_opacity = block.settings[opacity_key]
assign heading_color = block.settings[heading_color_key]
assign button_color = block.settings[button_color_key]
%}<section class="ai-slideshow-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }} of 3"{% unless forloop.first %} aria-hidden="true"{% endunless %}>{% if image %}<img class="ai-slideshow-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 2400 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% else %}<div class="ai-slideshow-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-slideshow-{{ ai_gen_id }}__panel" style="--bg:{{ panel_color }};--op:{{ panel_opacity | divided_by: 100.0 }};--pw:{{ block.settings.desktop_panel_width }}%;--pp:{{ block.settings.panel_padding }}px;--rad:{{ block.settings.panel_radius }}px;--bw:{{ block.settings.panel_border_width }}px;--bc:{{ block.settings.panel_border_color }};--ta:{{ block.settings.desktop_align }};--mta:{{ block.settings.mobile_align }};--mp:{{ block.settings.mobile_position }};--mpw:{{ block.settings.mobile_panel_width }}%;--mpp:{{ block.settings.mobile_padding }}px;--tc:{{ block.settings.text_color }};--hc:{{ heading_color }};--dc:{{ block.settings.text_color }};--hs:{{ block.settings.heading_size }}px;--mhs:{{ block.settings.mobile_heading_size }}px;--ds:{{ block.settings.description_size }}px;--mds:{{ block.settings.mobile_description_size }}px;--bb:{{ button_color }};--bt:{{ block.settings.button_text_color }};--bhv:{{ block.settings.button_hover_color }};--bht:{{ block.settings.button_hover_text_color }};--bbc:{{ block.settings.button_border_color }};--bbw:{{ block.settings.button_border_width }}px;--br:{{ block.settings.button_radius }}px;--bs:{{ block.settings.button_size }}px;--mbs:{{ block.settings.mobile_button_size }}px;--bh:{{ block.settings.button_height }}px;--bp:{{ block.settings.button_padding }}px;{% unless block.settings.panel_enabled %}background:transparent;border-color:transparent;box-shadow:none;padding:0;{% endunless %}">{% if heading != blank %}<h2 class="ai-slideshow-{{ ai_gen_id }}__heading">{{ heading | escape }}</h2>{% endif %}{% if desc != blank %}<div class="ai-slideshow-{{ ai_gen_id }}__desc">{{ desc }}</div>{% endif %}{% if button_text != blank %}{% if button_link != blank %}<a class="ai-slideshow-{{ ai_gen_id }}__button" href="{{ button_link }}">{{ button_text | escape }}</a>{% else %}<span class="ai-slideshow-{{ ai_gen_id }}__button">{{ button_text | escape }}</span>{% endif %}{% endif %}</div></section>{% endfor %}
{% if block.settings.show_arrows or block.settings.show_dots %}<div class="ai-slideshow-{{ ai_gen_id }}__controls">{% if block.settings.show_arrows %}<div><button class="ai-slideshow-{{ ai_gen_id }}__control" type="button" data-prev aria-label="Previous slide">‹</button> <button class="ai-slideshow-{{ ai_gen_id }}__control" type="button" data-next aria-label="Next slide">›</button></div>{% else %}<span></span>{% endif %}{% if block.settings.show_dots %}<div>{% for i in (1..3) %}<button class="ai-slideshow-{{ ai_gen_id }}__control ai-slideshow-{{ ai_gen_id }}__dot" type="button" data-go="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>{% endif %}</div>{% endif %}</div></ai-slideshow-{{ ai_gen_id }}>
<script>(function(){const t='ai-slideshow-{{ ai_gen_id }}';if(customElements.get(t))return;class Slider extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('[data-slide]')];this.d=[...this.querySelectorAll('[data-go]')];this.i=0;this.querySelector('[data-prev]')?.addEventListener('click',()=>this.go(this.i-1));this.querySelector('[data-next]')?.addEventListener('click',()=>this.go(this.i+1));this.d.forEach(b=>b.addEventListener('click',()=>this.go(+b.dataset.go)));this.play()}disconnectedCallback(){clearInterval(this.timer)}play(){clearInterval(this.timer);if(this.dataset.auto==='true'&&this.s.length>1)this.timer=setInterval(()=>this.go(this.i+1),+this.dataset.interval||5000)}go(n){this.i=(n+this.s.length)%this.s.length;this.s.forEach((s,j)=>{s.classList.toggle('is-active',j===this.i);j===this.i?s.removeAttribute('aria-hidden'):s.setAttribute('aria-hidden','true')});this.d.forEach((b,j)=>j===this.i?b.setAttribute('aria-current','true'):b.removeAttribute('aria-current'))}}customElements.define(t,Slider)})();</script>
