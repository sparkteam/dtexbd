{% doc %}
  @prompt
     create a button, button should be position option left right or center and add more thing in the button, button size should be open
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% case block.settings.button_size %}
  {% when 'small' %}
    {% assign ai_button_padding = '10px 18px' %}
    {% assign ai_button_min_height = '40px' %}
  {% when 'large' %}
    {% assign ai_button_padding = '18px 34px' %}
    {% assign ai_button_min_height = '60px' %}
  {% else %}
    {% assign ai_button_padding = '12px 24px' %}
    {% assign ai_button_min_height = '48px' %}
{% endcase %}

{% style %}
  .ai-button-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-align: {{ block.settings.alignment }};
  }

  .ai-button-block-{{ ai_gen_id }}__link {
    display: inline-flex;
    max-width: 100%;
    min-height: {{ ai_button_min_height }};
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: {{ ai_button_padding }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .ai-button-block-{{ ai_gen_id }}__link:hover {
    background-color: {{ block.settings.hover_color }};
    border-color: {{ block.settings.hover_color }};
    color: {{ block.settings.hover_text_color }};
  }

  .ai-button-block-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .ai-button-block-{{ ai_gen_id }}__icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .ai-button-block-{{ ai_gen_id }}__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-button-block-{{ ai_gen_id }}__icon--left {
    order: -1;
  }

  .ai-button-block-{{ ai_gen_id }}__note {
    margin: 8px 0 0;
    color: {{ block.settings.note_color }};
    font-size: 14px;
    line-height: 1.4;
  }
{% endstyle %}

<div class="ai-button-block-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.button_link != blank %}
    <a class="ai-button-block-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
      <span>{{ block.settings.button_text | escape }}</span>
      {% if block.settings.icon_style != 'none' %}
        <span class="ai-button-block-{{ ai_gen_id }}__icon{% if block.settings.icon_position == 'left' %} ai-button-block-{{ ai_gen_id }}__icon--left{% endif %}" aria-hidden="true">
          {% if block.settings.icon_style == 'arrow' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {% elsif block.settings.icon_style == 'chevron' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          {% endif %}
        </span>
      {% endif %}
    </a>
  {% else %}
    <span class="ai-button-block-{{ ai_gen_id }}__link" aria-disabled="true">
      <span>{{ block.settings.button_text | escape }}</span>
      {% if block.settings.icon_style != 'none' %}
        <span class="ai-button-block-{{ ai_gen_id }}__icon{% if block.settings.icon_position == 'left' %} ai-button-block-{{ ai_gen_id }}__icon--left{% endif %}" aria-hidden="true">
          {% if block.settings.icon_style == 'arrow' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {% elsif block.settings.icon_style == 'chevron' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          {% endif %}
        </span>
      {% endif %}
    </span>
  {% endif %}
  {% if block.settings.note != blank %}
    <p class="ai-button-block-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom button",
  "settings": [
    { "type": "header", "content": "Button content" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open link in a new tab", "default": false },
    { "type": "text", "id": "note", "label": "Text below button" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    { "type": "header", "content": "Icon" },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "chevron", "label": "Chevron" }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "button_color", "label": "Background", "default": "#0E4D22" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "hover_color", "label": "Hover background", "default": "#0E1B4D" },
    { "type": "color", "id": "hover_text_color", "label": "Hover text", "default": "#FFFFFF" },
    { "type": "color", "id": "note_color", "label": "Text below button", "default": "#333333" },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 6 }
  ],
  "presets": [{ "name": "Custom button" }],
  "tag": null,
  "class": "custom-button-block"
}
{% endschema %}