{% doc %}
  @prompt
    add space, spacer is not working
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-space-{{ ai_gen_id }} {
    display: block !important;
    box-sizing: border-box;
    flex: 0 0 {{ block.settings.desktop_width_percent }}%;
    width: {{ block.settings.desktop_width_percent }}%;
    min-width: 0;
    height: {{ block.settings.space_height }}px;
    min-height: {{ block.settings.space_height }}px;
    padding: 0;
    margin: 0;
    background-color: {{ block.settings.space_color }};
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-space-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
      min-height: {{ block.settings.mobile_height }}px;
    }
  }
{% endstyle %}

<div class="ai-space-{{ ai_gen_id }}" aria-hidden="true" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Space"
    },
    {
      "type": "range",
      "id": "space_height",
      "label": "Desktop height",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "space_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Spacer"
    }
  ],
  "tag": null,
  "class": "spacer-block"
}
{% endschema %}