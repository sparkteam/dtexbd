{% doc %}
  @prompt
    create ecommerce dynamic hero. Hero section should be change anything, any element. you can create create best shopify ecommerce theme ecommerce hero. add all the dynamic aptions. do not gorget to add single element,, every element sould be editable, add more banner in the hero add slide changing modern option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-slide-hero-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;min-height:{{ block.settings.desktop_height }}px;overflow:hidden;border-radius:{{ block.settings.corner_radius }}px;background:{{ block.settings.fallback_background }};color:#fff}
.ai-slide-hero-{{ ai_gen_id }} .slide{position:absolute;inset:0;display:flex;align-items:{{ block.settings.vertical_position }};justify-content:{{ block.settings.horizontal_position }};padding:{{ block.settings.content_padding }}px;opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s ease}
.ai-slide-hero-{{ ai_gen_id }} .slide.active{opacity:1;visibility:visible;z-index:1}
.ai-slide-hero-{{ ai_gen_id }} .media{position:absolute;inset:0}
.ai-slide-hero-{{ ai_gen_id }} .media img,.ai-slide-hero-{{ ai_gen_id }} .media svg{display:block;width:100%;height:100%;object-fit:cover}
.ai-slide-hero-{{ ai_gen_id }} .shade{position:absolute;inset:0;background:var(--overlay);opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }}}
.ai-slide-hero-{{ ai_gen_id }} .content{position:relative;z-index:1;width:100%;max-width:{{ block.settings.content_width }}px;text-align:{{ block.settings.text_alignment }};color:var(--text)}
.ai-slide-hero-{{ ai_gen_id }} .eyebrow{margin:0 0 12px;color:var(--accent);font-size:{{ block.settings.eyebrow_size }}px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.ai-slide-hero-{{ ai_gen_id }} .title{margin:0;color:inherit;font-size:{{ block.settings.heading_size }}px;line-height:1.08}
.ai-slide-hero-{{ ai_gen_id }} .description{margin-top:16px;font-size:{{ block.settings.description_size }}px;line-height:1.55}
.ai-slide-hero-{{ ai_gen_id }} .description p{margin:0 0 8px}
.ai-slide-hero-{{ ai_gen_id }} .actions{display:flex;flex-wrap:wrap;justify-content:{{ block.settings.button_position }};gap:12px;margin-top:24px}
.ai-slide-hero-{{ ai_gen_id }} .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;border:2px solid var(--button-bg);border-radius:{{ block.settings.button_radius }}px;background:var(--button-bg);color:var(--button-text);font-weight:700;text-decoration:none}
.ai-slide-hero-{{ ai_gen_id }} .button:focus-visible,.ai-slide-hero-{{ ai_gen_id }} .arrow:focus-visible,.ai-slide-hero-{{ ai_gen_id }} .dot:focus-visible{outline:3px solid #ff9a3c;outline-offset:3px}
.ai-slide-hero-{{ ai_gen_id }} .button.secondary{border-color:var(--button2-bg);background:var(--button2-bg);color:var(--button2-text)}
.ai-slide-hero-{{ ai_gen_id }} .badge{display:inline-block;margin-top:18px;padding:8px 14px;border-radius:99px;background:var(--badge-bg);color:var(--badge-text);font-size:14px;font-weight:700}
.ai-slide-hero-{{ ai_gen_id }} .controls{position:absolute;z-index:3;left:50%;bottom:20px;display:flex;align-items:center;gap:10px;transform:translateX(-50%)}
.ai-slide-hero-{{ ai_gen_id }} .arrow{display:{% if block.settings.show_arrows %}inline-flex{% else %}none{% endif %};align-items:center;justify-content:center;width:42px;height:42px;border:0;border-radius:50%;background:{{ block.settings.control_background }};color:{{ block.settings.control_color }};cursor:pointer}
.ai-slide-hero-{{ ai_gen_id }} .dots{display:{% if block.settings.show_dots %}flex{% else %}none{% endif %};gap:8px}
.ai-slide-hero-{{ ai_gen_id }} .dot{width:12px;height:12px;padding:0;border:1px solid {{ block.settings.control_background }};border-radius:50%;background:transparent;cursor:pointer}
.ai-slide-hero-{{ ai_gen_id }} .dot[aria-current=true]{background:{{ block.settings.control_background }}}
@media(prefers-reduced-motion:reduce){.ai-slide-hero-{{ ai_gen_id }} .slide{transition:none}}
@media(max-width:749px){.ai-slide-hero-{{ ai_gen_id }}{width:100%;min-height:{{ block.settings.mobile_height }}px;border-radius:{{ block.settings.corner_radius | at_most:20 }}px}.ai-slide-hero-{{ ai_gen_id }} .slide{padding:28px 20px 70px}.ai-slide-hero-{{ ai_gen_id }} .title{font-size:{{ block.settings.mobile_heading_size }}px}.ai-slide-hero-{{ ai_gen_id }} .description{font-size:{{ block.settings.mobile_description_size }}px}.ai-slide-hero-{{ ai_gen_id }} .actions{justify-content:{{ block.settings.mobile_button_position }}}.ai-slide-hero-{{ ai_gen_id }} .button{width:{% if block.settings.mobile_full_buttons %}100%{% else %}auto{% endif %}}}
{% endstyle %}
<slide-hero-{{ ai_gen_id }} class="ai-slide-hero-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.slide_interval | times:1000 }}" aria-roledescription="carousel" aria-label="{{ block.settings.carousel_label | escape }}" {{ block.shopify_attributes }}>
{% for i in (1..3) %}
{% liquid
assign enabled_key = 'slide_' | append: i | append: '_enabled'
assign image_key = 'slide_' | append: i | append: '_image'
assign mobile_key = 'slide_' | append: i | append: '_mobile_image'
assign eyebrow_key = 'slide_' | append: i | append: '_eyebrow'
assign title_key = 'slide_' | append: i | append: '_title'
assign desc_key = 'slide_' | append: i | append: '_description'
assign badge_key = 'slide_' | append: i | append: '_badge'
assign label_key = 'slide_' | append: i | append: '_button_label'
assign url_key = 'slide_' | append: i | append: '_button_url'
assign label2_key = 'slide_' | append: i | append: '_button2_label'
assign url2_key = 'slide_' | append: i | append: '_button2_url'
assign text_key = 'slide_' | append: i | append: '_text_color'
assign accent_key = 'slide_' | append: i | append: '_accent'
assign overlay_key = 'slide_' | append: i | append: '_overlay'
assign bg_key = 'slide_' | append: i | append: '_button_bg'
assign btntext_key = 'slide_' | append: i | append: '_button_text'
assign bg2_key = 'slide_' | append: i | append: '_button2_bg'
assign btntext2_key = 'slide_' | append: i | append: '_button2_text'
assign badgebg_key = 'slide_' | append: i | append: '_badge_bg'
assign badgetext_key = 'slide_' | append: i | append: '_badge_text'
assign enabled = block.settings[enabled_key]
assign image = block.settings[image_key]
assign mobile_image = block.settings[mobile_key]
%}
{% if enabled %}
<article class="slide{% if forloop.first %} active{% endif %}" data-slide="{{ i }}" aria-roledescription="slide" aria-label="Slide {{ i }} of 3"{% unless forloop.first %} aria-hidden="true"{% endunless %} style="--text:{{ block.settings[text_key] }};--accent:{{ block.settings[accent_key] }};--overlay:{{ block.settings[overlay_key] }};--button-bg:{{ block.settings[bg_key] }};--button-text:{{ block.settings[btntext_key] }};--button2-bg:{{ block.settings[bg2_key] }};--button2-text:{{ block.settings[btntext2_key] }};--badge-bg:{{ block.settings[badgebg_key] }};--badge-text:{{ block.settings[badgetext_key] }}">
<div class="media">{% if image != blank %}<picture>{% if mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ mobile_image | image_url: width:1200 }}">{% endif %}<img src="{{ image | image_url: width:2400 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}"></picture>{% else %}<div class="media">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div>
<div class="shade" aria-hidden="true"></div><div class="content">
{% if block.settings[eyebrow_key] != blank %}<p class="eyebrow">{{ block.settings[eyebrow_key] | escape }}</p>{% endif %}
{% if block.settings[title_key] != blank %}<h2 class="title">{{ block.settings[title_key] | escape }}</h2>{% endif %}
{% if block.settings[desc_key] != blank %}<div class="description">{{ block.settings[desc_key] }}</div>{% endif %}
<div class="actions">{% if block.settings[label_key] != blank and block.settings[url_key] != blank %}<a class="button" href="{{ block.settings[url_key] }}">{{ block.settings[label_key] | escape }}</a>{% endif %}{% if block.settings[label2_key] != blank and block.settings[url2_key] != blank %}<a class="button secondary" href="{{ block.settings[url2_key] }}">{{ block.settings[label2_key] | escape }}</a>{% endif %}</div>
{% if block.settings[badge_key] != blank %}<span class="badge">{{ block.settings[badge_key] | escape }}</span>{% endif %}</div></article>
{% endif %}{% endfor %}
<div class="controls"><button class="arrow" type="button" data-prev aria-label="Previous slide">&#8592;</button><div class="dots" role="group" aria-label="Choose a slide">{% for i in (1..3) %}{% liquid
assign enabled_key = 'slide_' | append: i | append: '_enabled'
assign enabled = block.settings[enabled_key]
%}{% if enabled %}<button class="dot" type="button" data-go="{{ i }}" aria-label="Go to slide {{ i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endif %}{% endfor %}</div><button class="arrow" type="button" data-next aria-label="Next slide">&#8594;</button></div></slide-hero-{{ ai_gen_id }}>
<script>(()=>{const tag='slide-hero-{{ ai_gen_id }}';if(customElements.get(tag))return;class SlideHero extends HTMLElement{connectedCallback(){this.slides=[...this.querySelectorAll('[data-slide]')];this.dots=[...this.querySelectorAll('[data-go]')];this.index=Math.max(0,this.slides.findIndex(s=>s.classList.contains('active')));this.prev=()=>this.show(this.index-1);this.next=()=>this.show(this.index+1);this.querySelector('[data-prev]')?.addEventListener('click',this.prev);this.querySelector('[data-next]')?.addEventListener('click',this.next);this.dots.forEach(d=>d.addEventListener('click',()=>this.show(this.slides.findIndex(s=>s.dataset.slide===d.dataset.go))));this.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')this.prev();if(e.key==='ArrowRight')this.next()});this.addEventListener('mouseenter',()=>this.stop());this.addEventListener('mouseleave',()=>this.start());this.addEventListener('focusin',()=>this.stop());this.start()}disconnectedCallback(){this.stop()}show(i){if(!this.slides.length)return;this.index=(i+this.slides.length)%this.slides.length;this.slides.forEach((s,n)=>{s.classList.toggle('active',n===this.index);if(n===this.index)s.removeAttribute('aria-hidden');else s.setAttribute('aria-hidden','true')});this.dots.forEach(d=>d.setAttribute('aria-current',d.dataset.go===this.slides[this.index].dataset.slide?'true':'false'))}start(){this.stop();if(this.dataset.autoplay==='true'&&this.slides.length>1&&!matchMedia('(prefers-reduced-motion: reduce)').matches)this.timer=setInterval(()=>this.show(this.index+1),Number(this.dataset.interval)||5000)}stop(){if(this.timer)clearInterval(this.timer)}}customElements.define(tag,SlideHero)})();</script>
