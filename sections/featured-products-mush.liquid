{% comment %}
  Featured Products — mixed catalog cards, brand colors, link to all products.
{% endcomment %}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    --fp-brand: #0e4d22;
    --fp-brand-deep: #0a3a1a;
    --fp-accent: #e7622c;
    --fp-cream: #f4efe6;
    --fp-ink: #172117;
    --fp-muted: #6d756d;
    --fp-line: rgba(14, 77, 34, 0.14);
    --fp-bg: {{ section.settings.section_bg }};
    --fp-radius: 16px;
    --fp-gap: {{ section.settings.grid_gap }}px;
    --fp-padding-top: {{ section.settings.padding_top }}px;
    --fp-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .fp-section {
    background: var(--fp-bg);
    padding-top: var(--fp-padding-top);
    padding-bottom: var(--fp-padding-bottom);
  }

  #shopify-section-{{ section.id }} .fp-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .fp-heading {
    color: var(--fp-ink);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    text-align: {{ section.settings.heading_align }};
    margin: 0 0 {{ section.settings.heading_margin }}px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .fp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: var(--fp-gap);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .fp-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fp-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .fp-card {
    background: #ffffff;
    border: 1px solid var(--fp-line);
    border-radius: var(--fp-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .fp-card:hover {
    transform: translateY(-4px);
    border-color: var(--fp-brand);
    box-shadow: 0 16px 34px rgba(14, 77, 34, 0.12);
  }

  #shopify-section-{{ section.id }} .fp-card:focus-visible {
    outline: 3px solid var(--fp-accent);
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .fp-image-wrap {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--fp-cream);
  }

  #shopify-section-{{ section.id }} .fp-image-wrap img,
  #shopify-section-{{ section.id }} .fp-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  #shopify-section-{{ section.id }} .fp-card:hover .fp-image-wrap img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .fp-sale-badge,
  #shopify-section-{{ section.id }} .fp-sold-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--fp-accent);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .fp-sold-badge {
    background: var(--fp-brand);
  }

  #shopify-section-{{ section.id }} .fp-info {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .fp-label {
    color: var(--fp-brand);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .fp-media-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fp-title {
    color: var(--fp-ink);
    font-size: {{ section.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fp-title:hover {
    color: var(--fp-brand);
  }

  #shopify-section-{{ section.id }} .fp-price-wrap {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .fp-price {
    color: var(--fp-brand);
    font-size: {{ section.settings.price_size }}px;
    font-weight: 700;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fp-compare {
    color: var(--fp-muted);
    font-size: {{ section.settings.compare_size }}px;
    text-decoration: line-through;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fp-atc-form,
  #shopify-section-{{ section.id }} .fp-atc-form-inner {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .fp-atc {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 42px;
    margin-top: 4px;
    padding: 10px 14px;
    border: 1px solid var(--fp-brand);
    border-radius: 8px;
    background: var(--fp-brand);
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
  }

  #shopify-section-{{ section.id }} .fp-atc:hover {
    background: var(--fp-accent);
    border-color: var(--fp-accent);
  }

  #shopify-section-{{ section.id }} .fp-atc:focus-visible {
    outline: 3px solid var(--fp-accent);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .fp-atc[disabled] {
    background: #e7ebe7;
    border-color: #e7ebe7;
    color: var(--fp-muted);
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .fp-atc.loading > span {
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .fp-atc .loading__spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%);
  }

  #shopify-section-{{ section.id }} .fp-atc .loading__spinner .path {
    stroke: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fp-atc {
      min-height: 40px;
      font-size: 13px;
      padding: 8px 10px;
    }
  }

</style>

<div class="fp-section">
  <div class="fp-container">
    {% if section.settings.heading != blank %}
      <h2 class="fp-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="fp-grid">
      {% if section.settings.collection != blank %}
        {% assign collection = collections[section.settings.collection] %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'fp-product-card-mush', product: product, section: section, label: product.type %}
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.type == 'product' and block.settings.product != blank %}
            {% assign product = all_products[block.settings.product] %}
            {% if product != blank %}
              <div {{ block.shopify_attributes }}>
                {% render 'fp-product-card-mush', product: product, section: section, label: block.settings.label %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Products Mush",
  "tag": "section",
  "class": "section-featured-products-mush",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link",
      "info": "Leave blank to use the All products collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "soldout_text",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns Tablet",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns Mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "label": "Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "label": "Card radius",
      "default": 12
    },
    {
      "type": "select",
      "id": "card_shadow",
      "label": "Shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "0 2px 8px rgba(0,0,0,0.06)", "label": "Soft" },
        { "value": "0 4px 16px rgba(0,0,0,0.08)", "label": "Medium" },
        { "value": "0 8px 24px rgba(0,0,0,0.12)", "label": "Strong" }
      ],
      "default": "0 4px 16px rgba(0,0,0,0.08)"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 28,
      "step": 2,
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 12,
      "max": 50,
      "step": 2,
      "label": "Heading margin",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 13,
      "max": 18,
      "step": 1,
      "label": "Title size",
      "default": 15
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#222222"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "label": "Price size",
      "default": 16
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "compare_size",
      "min": 12,
      "max": 16,
      "step": 1,
      "label": "Compare size",
      "default": 14
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Sale Badge"
    },
    {
      "type": "color",
      "id": "sale_badge_bg",
      "label": "Badge background",
      "default": "#e7622c"
    },
    {
      "type": "color",
      "id": "sale_badge_text",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "sale_font_size",
      "min": 11,
      "max": 14,
      "step": 1,
      "label": "Badge font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "sale_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "label": "Badge radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "sale_top",
      "min": 8,
      "max": 20,
      "step": 1,
      "label": "Badge top",
      "default": 12
    },
    {
      "type": "range",
      "id": "sale_left",
      "min": 8,
      "max": 20,
      "step": 1,
      "label": "Badge left",
      "default": 12
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "btn_border",
      "label": "Button border",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Hover background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "btn_hover_text",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "label": "Button radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "min": 13,
      "max": 16,
      "step": 1,
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "btn_padding_y",
      "min": 8,
      "max": 16,
      "step": 1,
      "label": "Padding Y",
      "default": 10
    },
    {
      "type": "range",
      "id": "btn_padding_x",
      "min": 12,
      "max": 30,
      "step": 2,
      "label": "Padding X",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Card label",
          "info": "Short type, such as Bedsheet, Curtain, or Comforter."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products Mush",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}