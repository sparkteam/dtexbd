{% comment %}
  Catalog grid — heading with a view-all link, then two rows of product cards.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --cg-brand: #0e4d22;
    --cg-ink: #172117;
    --cg-muted: #6d756d;
    --cg-line: rgba(14, 77, 34, 0.14);
    --cg-cream: #f4efe6;
    --cg-accent: #e7622c;
  }

  #shopify-section-{{ section.id }} .cg-section {
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .cg-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .cg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .cg-heading {
    margin: 0;
    color: var(--cg-ink);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .cg-view-all {
    color: #555555;
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid #555555;
    padding-bottom: 2px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .cg-view-all:hover {
    color: var(--cg-brand);
    border-color: var(--cg-brand);
  }

  #shopify-section-{{ section.id }} .cg-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  #shopify-section-{{ section.id }} .fp-card {
    background: #ffffff;
    border: 1px solid var(--cg-line);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .fp-card:hover {
    transform: translateY(-4px);
    border-color: var(--cg-brand);
    box-shadow: 0 16px 34px rgba(14, 77, 34, 0.12);
  }

  #shopify-section-{{ section.id }} .fp-image-wrap {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--cg-cream);
  }

  #shopify-section-{{ section.id }} .fp-image-wrap img,
  #shopify-section-{{ section.id }} .fp-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  #shopify-section-{{ section.id }} .fp-card:hover .fp-image-wrap img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .fp-sale-badge,
  #shopify-section-{{ section.id }} .fp-sold-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--cg-accent);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .fp-sold-badge {
    background: var(--cg-brand);
  }

  #shopify-section-{{ section.id }} .fp-info {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .fp-label {
    color: var(--cg-brand);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .fp-title {
    color: var(--cg-ink);
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }

  #shopify-section-{{ section.id }} .fp-price-wrap {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .fp-price {
    color: var(--cg-brand);
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fp-compare {
    color: var(--cg-muted);
    font-size: 14px;
    text-decoration: line-through;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cg-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .cg-heading {
      font-size: 22px;
    }
  }
</style>

<div class="cg-section">
  <div class="cg-container">
    <div class="cg-head">
      {% if section.settings.heading != blank %}
        <h2 class="cg-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.view_all_label != blank %}
        <a class="cg-view-all" href="{{ section.settings.view_all_link | default: '#' }}">
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    <div class="cg-grid">
      {% assign shown = 0 %}
      {% assign catalog = collections[section.settings.collection] %}
      {% for product in catalog.products %}
        {% if shown >= section.settings.products_to_show %}
          {% break %}
        {% endif %}
        {% if product.price > 0 %}
          {% assign title_down = product.title | downcase %}
          {% assign card_label = product.type %}
          {% if card_label == blank %}
            {% if title_down contains 'combo' %}
              {% assign card_label = 'Combo' %}
            {% elsif title_down contains 'solid' %}
              {% assign card_label = 'Solid' %}
            {% elsif title_down contains '3d' %}
              {% assign card_label = '3D' %}
            {% elsif title_down contains 'twill' %}
              {% assign card_label = 'Twill' %}
            {% elsif title_down contains 'perkel' or title_down contains 'parkel' %}
              {% assign card_label = 'Perkel' %}
            {% elsif title_down contains 'regular' %}
              {% assign card_label = 'Regular' %}
            {% elsif title_down contains 'export' %}
              {% assign card_label = 'Export' %}
            {% elsif title_down contains 'waffle' %}
              {% assign card_label = 'Waffle' %}
            {% else %}
              {% assign card_label = section.settings.card_label %}
            {% endif %}
          {% endif %}
          {% render 'fp-product-card-mush', product: product, section: section, label: card_label %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Catalog grid Mush",
  "tag": "section",
  "class": "section-catalog-grid-mush",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CURTAINS"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all curtains"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "card_label",
      "label": "Fallback card label",
      "default": "Curtain"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 40,
      "step": 1,
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "text",
      "id": "soldout_text",
      "label": "Sold out text",
      "default": "Sold out"
    }
  ],
  "presets": [
    {
      "name": "Catalog grid Mush"
    }
  ]
}
{% endschema %}
