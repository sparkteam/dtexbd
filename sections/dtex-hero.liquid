<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@500;700;800&family=Questrial&display=swap" rel="stylesheet">

{%- style -%}
  #DtexHero-{{ section.id }} {
    --dtex-brand: {{ section.settings.panel_color }};
    --dtex-card: {{ section.settings.card_color }};
    --dtex-ink: {{ section.settings.text_color }};
    --dtex-accent: {{ section.settings.accent_color }};
    --dtex-btn: {{ section.settings.button_color }};
    --dtex-btn-text: {{ section.settings.button_text }};
    --dtex-interval: {{ section.settings.interval }}s;
  }
{%- endstyle -%}

<dtex-hero
  id="DtexHero-{{ section.id }}"
  class="dtex-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="dtex-hero__frame">
    <div class="dtex-hero__media">
      {%- for block in section.blocks -%}
        <div
          class="dtex-hero__photo{% if forloop.first %} is-active{% endif %}"
          data-hero-photo="{{ forloop.index0 }}"
          style="--dtex-pos-x: {{ block.settings.image_x }}%; --dtex-pos-y: {{ block.settings.image_y }}%; --dtex-pos-x-mobile: {{ block.settings.image_x_mobile }}%;"
        >
          {%- if block.settings.image != blank -%}
            {%- assign hero_alt = block.settings.image.alt | default: block.settings.heading | default: block.settings.kicker -%}
            {%- if forloop.first and section.index == 1 -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000, 2400',
                  sizes: '100vw',
                  alt: hero_alt,
                  fetchpriority: 'high',
                  class: 'dtex-hero__img'
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000, 2400',
                  sizes: '100vw',
                  alt: hero_alt,
                  loading: 'lazy',
                  class: 'dtex-hero__img'
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'dtex-hero__img dtex-hero__placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <div class="dtex-hero__arrows">
          <button class="dtex-hero__arrow" type="button" data-hero-prev aria-label="Previous slide">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="dtex-hero__arrow" type="button" data-hero-next aria-label="Next slide">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="dtex-hero__wrap">
      <div class="dtex-hero__card">
        <div class="dtex-hero__stories">
          {%- assign hero_h1_used = false -%}
          {%- for block in section.blocks -%}
            <div
              class="dtex-hero__story{% if forloop.first %} is-active{% endif %}"
              data-hero-slide="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
              {% unless forloop.first %}hidden{% endunless %}
            >
              <p class="dtex-hero__kicker">
                <span class="dtex-hero__kicker-num">0{{ forloop.index }}</span>
                <span class="dtex-hero__kicker-label">{{ block.settings.kicker | escape }}</span>
              </p>
              {%- if block.settings.heading != blank -%}
                {%- if block.settings.use_h1 and hero_h1_used == false and template.name == 'index' -%}
                  {%- assign hero_h1_used = true -%}
                  <h1 class="dtex-hero__heading dtex-hero__heading--h1">{{ block.settings.heading | escape }}</h1>
                {%- else -%}
                  <h2 class="dtex-hero__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="dtex-hero__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  class="dtex-hero__btn"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.button_label | escape }}
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="dtex-hero__note">{{ block.settings.note | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="dtex-hero__tabs" role="tablist" aria-label="Choose a category">
            {%- for block in section.blocks -%}
              <button
                class="dtex-hero__tab{% if forloop.first %} is-active{% endif %}"
                type="button"
                role="tab"
                data-hero-tab="{{ forloop.index0 }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ block.settings.tab_label | default: block.settings.kicker | escape }}"
              >
                <span class="dtex-hero__tab-index">0{{ forloop.index }}</span>
                <span class="dtex-hero__tab-label">{{ block.settings.tab_label | default: block.settings.kicker | escape }}</span>
                <span class="dtex-hero__bar" aria-hidden="true"><span class="dtex-hero__bar-fill"></span></span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</dtex-hero>

{% stylesheet %}
  .dtex-hero {
    display: block;
    position: relative;
    background: #efe8dc;
    color: #172117;
  }

  .dtex-hero__frame {
    position: relative;
    height: clamp(560px, calc(100svh - 140px), 720px);
    overflow: hidden;
  }

  .dtex-hero__media {
    position: absolute;
    inset: 0;
    background: #e6dfd3;
    overflow: hidden;
  }

  .dtex-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(23, 33, 23, 0.18) 0%, rgba(23, 33, 23, 0.04) 38%, rgba(23, 33, 23, 0) 60%);
  }

  .dtex-hero__photo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .dtex-hero__photo.is-active {
    opacity: 1;
    z-index: 1;
  }

  .dtex-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--dtex-pos-x, 50%) var(--dtex-pos-y, 50%);
    transform: scale(1.05);
  }

  .dtex-hero__photo.is-active .dtex-hero__img {
    animation: dtex-hero-ken 9s ease forwards;
  }

  .dtex-hero__placeholder {
    background: #efe8dc;
  }

  @keyframes dtex-hero-ken {
    from { transform: scale(1.05); }
    to { transform: scale(1); }
  }

  .dtex-hero__wrap {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(24px, 4vw, 56px);
    pointer-events: none;
  }

  .dtex-hero__card {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    width: min(460px, 42%);
    min-width: 360px;
    padding: 34px 34px 22px;
    border-radius: 22px;
    background: var(--dtex-card, #fbf8f2);
    color: var(--dtex-ink, #172117);
    box-shadow: 0 24px 60px rgba(23, 33, 23, 0.18), 0 2px 8px rgba(23, 33, 23, 0.06);
  }

  .dtex-hero__stories {
    position: relative;
  }

  .dtex-hero__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: dtex-hero-rise 0.55s ease both;
  }

  .dtex-hero__story[hidden] {
    display: none;
  }

  @keyframes dtex-hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dtex-hero__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font-family: Questrial, "Noto Sans Bengali", sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .dtex-hero__kicker-num {
    color: var(--dtex-accent, #f0a05a);
    letter-spacing: 0.08em;
  }

  .dtex-hero__kicker-label {
    color: var(--dtex-brand, #0e4d22);
  }

  .dtex-hero__kicker::after {
    content: "";
    width: 46px;
    height: 1px;
    background: var(--dtex-accent, #f0a05a);
  }

  .dtex-hero__heading {
    margin: 0;
    color: var(--dtex-ink, #172117);
    font-family: "Noto Sans Bengali", Almarai, sans-serif;
    font-size: clamp(32px, 3.2vw, 46px);
    text-wrap: balance;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .dtex-hero__heading--h1 {
    font-size: clamp(30px, 2.7vw, 40px);
    line-height: 1.18;
  }

  .dtex-hero__text {
    margin: 14px 0 0;
    max-width: 400px;
    color: var(--dtex-ink, #172117);
    opacity: 0.8;
    font-family: "Noto Sans Bengali", Questrial, sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.65;
  }

  .dtex-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    min-height: 48px;
    padding: 0 22px 0 24px;
    border-radius: 999px;
    background: var(--dtex-btn, #0e4d22);
    color: var(--dtex-btn-text, #ffffff);
    font-family: Questrial, "Noto Sans Bengali", sans-serif;
    font-size: 16px;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(14, 77, 34, 0.22);
    transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
  }

  .dtex-hero__btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .dtex-hero__btn:hover {
    filter: brightness(1.12);
    box-shadow: 0 10px 26px rgba(14, 77, 34, 0.3);
  }

  .dtex-hero__btn:hover svg {
    transform: translateX(3px);
  }

  .dtex-hero__note {
    margin: 14px 0 0;
    color: var(--dtex-ink, #172117);
    opacity: 0.62;
    font-family: Questrial, sans-serif;
    font-size: 13px;
    letter-spacing: 0.03em;
  }

  .dtex-hero__tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 6px;
    margin: 28px 0 0;
    border-top: 1px solid rgba(23, 33, 23, 0.1);
  }

  .dtex-hero__tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 12px 0 6px;
    border: 0;
    background: transparent;
    color: var(--dtex-ink, #172117);
    opacity: 0.55;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .dtex-hero__tab:hover {
    opacity: 0.85;
  }

  .dtex-hero__tab.is-active {
    color: var(--dtex-brand, #0e4d22);
    opacity: 1;
  }

  .dtex-hero__tab-index {
    font-family: Questrial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .dtex-hero__tab-label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: Questrial, "Noto Sans Bengali", sans-serif;
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .dtex-hero__tabs:has(> :nth-child(4)) .dtex-hero__tab-label {
    font-size: 13px;
    letter-spacing: 0;
  }

  .dtex-hero__bar {
    display: block;
    width: 100%;
    height: 3px;
    margin-top: 8px;
    border-radius: 3px;
    background: rgba(23, 33, 23, 0.1);
    overflow: hidden;
  }

  .dtex-hero__bar-fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--dtex-accent, #f0a05a);
  }

  .dtex-hero__tab.is-active .dtex-hero__bar-fill {
    animation: dtex-hero-fill var(--dtex-interval, 6s) linear forwards;
  }

  .dtex-hero.is-paused .dtex-hero__bar-fill {
    animation-play-state: paused;
  }

  @keyframes dtex-hero-fill {
    from { width: 0; }
    to { width: 100%; }
  }

  .dtex-hero__arrows {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 10px;
  }

  .dtex-hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    color: #172117;
    box-shadow: 0 8px 24px rgba(23, 33, 23, 0.18);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .dtex-hero__arrow svg {
    width: 18px;
    height: 18px;
  }

  .dtex-hero__arrow:hover {
    background: #fff;
    transform: scale(1.06);
  }

  .dtex-hero__btn:focus-visible,
  .dtex-hero__tab:focus-visible,
  .dtex-hero__arrow:focus-visible {
    outline: 3px solid var(--dtex-accent, #f0a05a);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dtex-hero__photo,
    .dtex-hero__btn,
    .dtex-hero__img,
    .dtex-hero__story {
      transition: none;
      animation: none;
    }

    .dtex-hero__tab.is-active .dtex-hero__bar-fill {
      animation: none;
      width: 100%;
    }
  }

  @media screen and (max-width: 989px) {
    .dtex-hero__frame {
      height: auto;
      overflow: visible;
    }

    .dtex-hero__media {
      position: relative;
      inset: auto;
      height: min(96vw, 560px);
    }

    .dtex-hero__media::after {
      background: linear-gradient(180deg, rgba(23, 33, 23, 0) 65%, rgba(23, 33, 23, 0.14) 100%);
    }

    .dtex-hero__img {
      object-position: var(--dtex-pos-x-mobile, 50%) var(--dtex-pos-y, 50%);
    }

    .dtex-hero__arrows {
      right: 14px;
      bottom: auto;
      top: 14px;
      gap: 8px;
    }

    .dtex-hero__arrow {
      width: 40px;
      height: 40px;
    }

    .dtex-hero__wrap {
      display: block;
      height: auto;
      margin-top: -56px;
      padding: 0 14px 24px;
    }

    .dtex-hero__card {
      width: 100%;
      min-width: 0;
      padding: 24px 20px 14px;
      border-radius: 18px;
    }

    .dtex-hero__heading {
      font-size: 30px;
    }

    .dtex-hero__heading--h1 {
      font-size: 28px;
    }

    .dtex-hero__text {
      font-size: 15px;
    }

    .dtex-hero__btn {
      margin-top: 20px;
    }

    .dtex-hero__tabs {
      margin-top: 20px;
    }

    .dtex-hero__tab-label,
    .dtex-hero__tabs:has(> :nth-child(4)) .dtex-hero__tab-label {
      font-size: 12px;
      letter-spacing: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('dtex-hero')) {
    class DtexHero extends HTMLElement {
      connectedCallback() {
        if (this.dataset.bound === 'true') return;
        this.dataset.bound = 'true';
        this.stories = [...this.querySelectorAll('[data-hero-slide]')];
        this.photos = [...this.querySelectorAll('[data-hero-photo]')];
        this.tabs = [...this.querySelectorAll('[data-hero-tab]')];
        this.index = 0;
        this.paused = false;
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.querySelector('[data-hero-prev]')?.addEventListener('click', () => this.show(this.index - 1));
        this.querySelector('[data-hero-next]')?.addEventListener('click', () => this.show(this.index + 1));
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => this.show(index));
        });
        this.addEventListener('animationend', (event) => {
          if (event.animationName !== 'dtex-hero-fill' || this.paused || this.reduce || this.ignoreEnd) return;
          if (this.dataset.autoplay !== 'true') return;
          const tab = event.target.closest('[data-hero-tab]');
          if (!tab || Number(tab.dataset.heroTab) !== this.index) return;
          this.show(this.index + 1);
        });
        this.addEventListener('mouseenter', () => this.setPaused(true));
        this.addEventListener('mouseleave', () => this.setPaused(false));
        this.addEventListener('focusin', () => this.setPaused(true));
        this.addEventListener('focusout', (event) => {
          if (!this.contains(event.relatedTarget)) this.setPaused(false);
        });
        this.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') this.show(this.index - 1);
          if (event.key === 'ArrowRight') this.show(this.index + 1);
        });
        this.restartBar();
      }

      setPaused(paused) {
        this.paused = paused;
        this.classList.toggle('is-paused', paused);
      }

      show(nextIndex) {
        if (!this.stories.length) return;
        this.ignoreEnd = true;
        const total = this.stories.length;
        this.index = (nextIndex + total) % total;
        this.stories.forEach((story, index) => {
          const active = index === this.index;
          story.classList.toggle('is-active', active);
          story.toggleAttribute('hidden', !active);
        });
        this.photos.forEach((photo, index) => {
          photo.classList.toggle('is-active', index === this.index);
        });
        this.tabs.forEach((tab, index) => {
          const active = index === this.index;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        this.restartBar();
        requestAnimationFrame(() => {
          this.ignoreEnd = false;
        });
      }

      restartBar() {
        const active = this.tabs[this.index];
        if (!active) return;
        const fill = active.querySelector('.dtex-hero__bar-fill');
        if (!fill) return;
        fill.style.animation = 'none';
        void fill.offsetWidth;
        fill.style.animation = '';
      }
    }

    customElements.define('dtex-hero', DtexHero);
  }
{% endjavascript %}

{% schema %}
{
  "name": "DTex hero",
  "tag": "section",
  "class": "dtex-hero-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slideshow label",
      "default": "Featured categories"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "min": 4,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "Seconds per slide",
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#fbf8f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text",
      "default": "#172117"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Brand color (eyebrow, active tab)",
      "default": "#0e4d22"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f0a05a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#0e4d22"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_x",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image horizontal position (desktop)",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_x_mobile",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image horizontal position (mobile)",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_y",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Image vertical position",
          "default": 50
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Eyebrow",
          "default": "Bedsheet"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "নরম কটন বেডশিট"
        },
        {
          "type": "checkbox",
          "id": "use_h1",
          "label": "Use as homepage H1",
          "info": "Turn on for one slide only. The first checked slide renders its heading as the page H1; others stay H2.",
          "default": false
        },
        {
          "type": "textarea",
