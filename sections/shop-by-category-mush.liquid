{% comment %}
  Shop By Category Mush - Fully Customizable (Centered Image + Border + Background)
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --sbc-bg: {{ section.settings.section_bg }};
    --sbc-heading-color: {{ section.settings.heading_color }};
    --sbc-text-color: {{ section.settings.text_color }};
    --sbc-circle-bg: {{ section.settings.circle_bg }};
    --sbc-circle-border: {{ section.settings.circle_border_width }}px solid {{ section.settings.circle_border_color }};
    --sbc-circle-size: {{ section.settings.circle_size }}px;
    --sbc-gap: {{ section.settings.item_gap }}px;
    --sbc-padding-top: {{ section.settings.padding_top }}px;
    --sbc-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sbc-section {
    background: var(--sbc-bg);
    padding-top: var(--sbc-padding-top);
    padding-bottom: var(--sbc-padding-bottom);
  }

  #shopify-section-{{ section.id }} .sbc-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .sbc-heading {
    text-align: {{ section.settings.heading_align }};
    color: var(--sbc-heading-color);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_transform }};
    margin: 0 0 {{ section.settings.heading_margin }}px;
  }

  #shopify-section-{{ section.id }} .sbc-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: var(--sbc-gap);
    justify-items: center;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sbc-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sbc-grid {
      {% if section.settings.mobile_carousel %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: {{ section.settings.mobile_gap }}px;
        padding-bottom: 12px;
        -webkit-overflow-scrolling: touch;
      {% else %}
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      {% endif %}
    }

    {% if section.settings.mobile_carousel %}
      #shopify-section-{{ section.id }} .sbc-item {
        flex: 0 0 {{ section.settings.mobile_item_width }}px;
        scroll-snap-align: start;
      }
    {% endif %}
  }

  #shopify-section-{{ section.id }} .sbc-item {
    text-align: center;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .sbc-item:hover {
    transform: translateY(-5px);
  }

  /* ===== Circle with perfect centered image ===== */
  #shopify-section-{{ section.id }} .sbc-circle {
    width: var(--sbc-circle-size);
    height: var(--sbc-circle-size);
    border-radius: 50%;
    background-color: var(--sbc-circle-bg);
    border: var(--sbc-circle-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin: 0 auto {{ section.settings.image_margin }}px;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .sbc-item:hover .sbc-circle {
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
  }

  #shopify-section-{{ section.id }} .sbc-circle img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .sbc-title {
    color: var(--sbc-text-color);
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.3;
    margin: 0;
  }

  /* Scrollbar style for mobile carousel */
  #shopify-section-{{ section.id }} .sbc-grid::-webkit-scrollbar {
    height: 4px;
  }
  #shopify-section-{{ section.id }} .sbc-grid::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }
</style>

<div class="sbc-section">
  <div class="sbc-container">

    {% if section.settings.heading != blank %}
      <h2 class="sbc-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="sbc-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a href="{{ block.settings.link | default: '#' }}" class="sbc-item" {{ block.shopify_attributes }}>
            <div class="sbc-circle">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  widths: '150, 200, 250, 300, 400',
                  alt: block.settings.title | escape
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <p class="sbc-title">{{ block.settings.title }}</p>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Shop By Category Mush",
  "tag": "section",
  "class": "section-shop-by-category-mush",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 42,
      "step": 1,
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "label": "Heading letter spacing",
      "default": 1
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 10,
      "max": 60,
      "step": 2,
      "label": "Heading bottom margin",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 4,
      "max": 10,
      "step": 1,
      "label": "Columns - Desktop",
      "default": 9
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns - Tablet",
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns - Mobile (when carousel off)",
      "default": 3
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "label": "Gap between items",
      "default": 24
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "label": "Container max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Carousel"
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Enable carousel on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_item_width",
      "min": 80,
      "max": 140,
      "step": 5,
      "label": "Mobile item width",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 30,
      "step": 2,
      "label": "Mobile gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Circle Style"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 70,
      "max": 140,
      "step": 5,
      "label": "Circle size",
      "default": 110
    },
    {
      "type": "color",
      "id": "circle_bg",
      "label": "Circle background color",
      "default": "#f3e8ff"
    },
    {
      "type": "color",
      "id": "circle_border_color",
      "label": "Circle border color",
      "default": "#e9d5ff"
    },
    {
      "type": "range",
      "id": "circle_border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "label": "Circle border thickness",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit inside circle",
      "options": [
        { "value": "cover", "label": "Cover (fill the circle)" },
        { "value": "contain", "label": "Contain (show full image)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "image_margin",
      "min": 6,
      "max": 20,
      "step": 1,
      "label": "Space under circle",
      "default": 12
    },
    {
      "type": "header",
      "content": "Text Style"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "label": "Category title size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Category title weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Category title color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "New Arrivals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Collection / Page)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category Mush",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "New Arrivals"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bedsheets"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Comforters"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Winter Quilts"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Cushions"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Curtains"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Women"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bags"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sale"
          }
        }
      ]
    }
  ]
}
{% endschema %}