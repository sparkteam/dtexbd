{%- liquid
  assign uid = section.id | handle
  assign col = section.settings.collection
  assign n = section.settings.image_count
  assign link = section.settings.button_link
  if link == blank and col != blank
    assign link = col.url
  endif
  assign img_blocks = section.blocks | where: 'type', 'image'
  assign has_manual = false
  for b in img_blocks
    if b.settings.image != blank
      assign has_manual = true
    endif
  endfor
-%}
<style>
  #pb-{{ uid }}{padding:{{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px}
  #pb-{{ uid }} .pb{max-width:1400px;margin:0 auto;display:flex;align-items:center;gap:32px;min-height:170px;padding:16px 40px;border-radius:20px;overflow:hidden;position:relative;background:linear-gradient(110deg,{{ section.settings.bg_start }} 0%,{{ section.settings.bg_end }} 100%);color:{{ section.settings.text_color }}}
  #pb-{{ uid }} .pb::before{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:{{ section.settings.accent }};opacity:.18;pointer-events:none}
  #pb-{{ uid }} .pb--right{flex-direction:row-reverse}
  #pb-{{ uid }} .pb__imgs{flex:0 0 auto;display:flex;align-items:center;padding-left:10px}
  #pb-{{ uid }} .pb__img{width:118px;height:138px;border-radius:14px;overflow:hidden;border:3px solid #fff;box-shadow:0 10px 24px rgba(0,0,0,.18);margin-left:-26px;background:#fff;transition:transform .35s ease}
  #pb-{{ uid }} .pb__img:first-child{margin-left:0}
  #pb-{{ uid }} .pb__img:nth-child(odd){transform:rotate(-5deg)}
  #pb-{{ uid }} .pb__img:nth-child(even){transform:rotate(4deg) translateY(-6px)}
  #pb-{{ uid }} .pb__imgs:hover .pb__img{transform:none}
  #pb-{{ uid }} .pb__img img{width:100%;height:100%;object-fit:cover;display:block}
  #pb-{{ uid }} .pb__body{flex:1;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;z-index:1}
  #pb-{{ uid }} .pb__pill{display:inline-block;background:{{ section.settings.accent }};color:#fff;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:8px}
  #pb-{{ uid }} .pb__title{margin:0 0 6px;font-size:clamp(20px,2.3vw,30px);line-height:1.15;color:inherit}
  #pb-{{ uid }} .pb__text{margin:0;font-size:15px;line-height:1.5;opacity:.85;max-width:560px}
  #pb-{{ uid }} .pb__btn{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 26px;border-radius:10px;background:{{ section.settings.button_color }};color:#fff;font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;transition:transform .25s,box-shadow .25s}
  #pb-{{ uid }} .pb__btn:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.18)}
  @media (max-width:989px){#pb-{{ uid }} .pb__body{flex-direction:column;align-items:flex-start;gap:14px}}
  @media (max-width:749px){
    #pb-{{ uid }} .pb,#pb-{{ uid }} .pb--right{flex-direction:column;align-items:flex-start;gap:14px;padding:18px 18px 20px;min-height:0}
    #pb-{{ uid }} .pb__img{width:84px;height:96px;margin-left:-18px}
    #pb-{{ uid }} .pb__img:nth-child(n+4){display:none}
    #pb-{{ uid }} .pb__btn{width:100%;justify-content:center}
  }
</style>
<div id="pb-{{ uid }}">
  <div class="pb{% if section.settings.image_side == 'right' %} pb--right{% endif %}">
    <div class="pb__imgs">
      {%- if has_manual -%}
        {%- for b in img_blocks -%}
          {%- if b.settings.image != blank -%}
            <a class="pb__img" href="{{ b.settings.link | default: link }}" {{ b.shopify_attributes }}>{{ b.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: b.settings.image.alt }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif col != blank -%}
        {%- assign shown = 0 -%}
        {%- for p in col.products -%}
          {%- if shown >= n -%}{%- break -%}{%- endif -%}
          {%- if p.featured_image -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="pb__img" href="{{ p.url }}" aria-label="{{ p.title | escape }}">{{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}<span class="pb__img">{{ 'product-1' | placeholder_svg_tag }}</span>{%- endfor -%}
      {%- endif -%}
    </div>
    <div class="pb__body">
      <div>
        {%- if section.settings.pill != blank -%}<span class="pb__pill">{{ section.settings.pill | escape }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="pb__title h2">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="pb__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}<a class="pb__btn" href="{{ link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} &rarr;</a>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Dtex promo banner",
  "tag": "section",
  "class": "section-dtex-promo-banner",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "collection", "id": "collection", "label": "Collection (images + button link)" },
    { "type": "range", "id": "image_count", "label": "Number of images", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "image_side", "label": "Image side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "paragraph", "content": "Add \"Image\" blocks to use your own photos instead of the collection's product images." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "pill", "label": "Pill label", "default": "Winter Collection" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wrap Yourself in Cloud-Soft Comfort" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Comforters" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = the collection above" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_start", "label": "Background gradient start", "default": "#fbf3e8" },
    { "type": "color", "id": "bg_end", "label": "Background gradient end", "default": "#f6dcc6" },
    { "type": "color", "id": "accent", "label": "Accent (pill)", "default": "#e7622c" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#0d6239" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 8 }
  ],
  "blocks": [
    { "type": "image", "name": "Image (manual)", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "link", "label": "Link (optional)" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "Dtex promo banner" } ]
}
{% endschema %}
